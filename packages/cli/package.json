{
  "name": "@applift/cli",
  "version": "0.6.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/hcg1023/applift.git",
    "directory": "packages/cli"
  },
  "bin": {
    "applift": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown src/bin.ts src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@applift/core": "workspace:*",
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15"
  }
}
