{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "applift",
  "version": "0.1.0",
  "identifier": "com.applift.shell",
  "build": {
    "devUrl": null,
    "frontendDist": "../../ui-server/dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "applift",
        "width": 1280,
        "height": 800,
        "url": "startup.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ui-server": "ui-server"
    }
  },
  "mainBinaryName": "applift"
}
