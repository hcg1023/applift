{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "applift",
  "version": "0.1.0",
  "identifier": "com.applift.shell",
  "build": {
    "beforeDevCommand": "node ../scripts/prepare-frontend.mjs",
    "beforeBuildCommand": "node ../scripts/prepare-frontend.mjs",
    "devUrl": null,
    "frontendDist": "../../ui-server/dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "applift",
        "width": 1280,
        "height": 800,
        "url": "startup.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
