{
  "name": "@applift/ui-server",
  "version": "0.1.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./main": {
      "import": "./dist/main.mjs",
      "default": "./dist/main.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/main.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.1"
  }
}
