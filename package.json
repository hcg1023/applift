{
  "name": "applift",
  "private": true,
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "dev": "pnpm -r --parallel run dev",
    "smoke": "pnpm -r build && node packages/cli/dist/bin.mjs --help >/dev/null && node packages/cli/dist/bin.mjs channels --json >/dev/null && node packages/cli/dist/bin.mjs doctor --cwd /tmp >/dev/null 2>&1; echo smoke-ok",
    "changeset": "changeset",
    "pack-version": "changeset version",
    "release": "pnpm -r build && changeset publish && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.5.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
